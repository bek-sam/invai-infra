# Scanner images for `pnpm scan` and the CI scan jobs. Pinned by digest (index digest, multi-arch);
# the comment is the version the digest was resolved from on 2026-10-10. Bump by:
#   docker buildx imagetools inspect <image>:<tag> | grep Digest
# then run `pnpm scan:test`, and mirror the same digests in the `scan` job of every repo's
# .github/workflows/ci.yml (scripts/scan.sh pins checks that the two lists agree).
GITLEAKS_IMAGE=ghcr.io/gitleaks/gitleaks@sha256:c00b6bd0aeb3071cbcb79009cb16a60dd9e0a7c60e2be9ab65d25e6bc8abbb7f
TRIVY_IMAGE=aquasec/trivy@sha256:af6acf9a6b85dfe389a1941505c0ce9efef52a4719635e1a962f022a3d855daa
ACTIONLINT_IMAGE=rhysd/actionlint@sha256:b1934ee5f1c509618f2508e6eb47ee0d3520686341fec936f3b79331f9315667
# gitleaks v8.30.1, trivy 0.75.0, actionlint 1.7.12.
# Probe image for the BuildKit ignore-file canary: the same node:24-slim digest the Dockerfiles use.
PROBE_IMAGE=node:24-slim@sha256:d6aa754f16b3197301076f047b5def2f02ea1dbbc2ca920407d46d7ec7f87b20
