{
  "name": "invai-infra",
  "version": "0.1.0",
  "private": true,
  "description": "InvAI AWS infrastructure (SST) and local dev services",
  "type": "module",
  "scripts": {
    "deploy:staging": "sst deploy --stage staging --target Migrate && pnpm release:migrate:staging && sst deploy --stage staging",
    "deploy:prod": "sst deploy --stage production --target Migrate && pnpm release:migrate:prod && sst deploy --stage production",
    "release:migrate:staging": "sst shell --stage staging -- node infra/run-migrate.ts",
    "release:migrate:prod": "sst shell --stage production -- node infra/run-migrate.ts",
    "local:up": "docker compose -f local/docker-compose.yml up -d",
    "local:down": "docker compose -f local/docker-compose.yml down",
    "local:full": "bash scripts/full.sh up",
    "scan": "bash scripts/scan.sh",
    "scan:test": "bash scripts/scan.test.sh",
    "dev:all": "bash scripts/dev.sh",
    "stop": "bash scripts/stop.sh",
    "reset-db": "bash scripts/reset-db.sh",
    "gate": "bash scripts/gate.sh",
    "lint": "biome check .",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.14",
    "@types/node": "^26.6.2",
    "concurrently": "^10.0.6",
    "sst": "^4.17.1",
    "typescript": "^7.0.2"
  },
  "packageManager": "pnpm@12.6.0",
  "engines": {
    "node": ">=24"
  }
}
