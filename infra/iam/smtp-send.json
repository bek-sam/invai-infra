{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Effect": "Allow",
      "Action": "ses:SendRawEmail",
      "Resource": [
        "arn:aws:ses:<REGION>:<ACCOUNT_ID>:identity/<MAIL_DOMAIN>",
        "arn:aws:ses:<REGION>:<ACCOUNT_ID>:configuration-set/<CONFIG_SET_NAME>"
      ]
    }
  ]
}
